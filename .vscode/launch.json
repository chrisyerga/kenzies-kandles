{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Astro Dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--inspect", "${workspaceFolder}/node_modules/astro/astro.js", "dev"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug migrate.js",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/migrate.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug seed.js",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
