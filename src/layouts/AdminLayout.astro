---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Kenzie's Kandles Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="admin">
  <div class="topbar">
    <div class="topbar-brand">
      Kenzie's <span>KANDLES</span>
    </div>
    <nav class="topbar-nav">
      <a href="/admin/products" class={Astro.url.pathname.includes('/products') ? 'active' : ''}>Products</a>
      <a href="/admin/contacts" class={Astro.url.pathname.includes('/contacts') ? 'active' : ''}>Contacts</a>
      <a href="/" target="_blank">↗ View Site</a>
    </nav>
    <div class="topbar-logout">
      <form method="POST" action="/api/admin/logout">
        <button type="submit">Log out</button>
      </form>
    </div>
  </div>
  <main class="admin-main">
    <slot />
  </main>
</body>
</html>

<style is:global>
  .admin *,
  .admin *::before,
  .admin *::after {
    box-sizing: border-box;
  }

  .admin {
    font-family: 'Inter', sans-serif;
    background: #0d0125;
    color: #e2d9f3;
    min-height: 100vh;
    margin: 0;
  }

  .admin a {
    color: #c4b5fd;
    text-decoration: none;
  }

  .admin a:hover {
    color: #e879f9;
  }

  .admin .topbar {
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(196, 181, 253, 0.12);
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 56px;
  }

  .admin .topbar-brand {
    font-family: 'Dancing Script', cursive;
    font-size: 1.4rem;
    color: #e879f9;
    white-space: nowrap;
  }

  .admin .topbar-brand span {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: #c4b5fd;
    text-transform: uppercase;
  }

  .admin .topbar-nav {
    display: flex;
    gap: 0.25rem;
    flex: 1;
  }

  .admin .topbar-nav a {
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: #a78bca;
    transition: all 0.15s;
  }

  .admin .topbar-nav a:hover,
  .admin .topbar-nav a.active {
    background: rgba(196, 181, 253, 0.1);
    color: #e2d9f3;
  }

  .admin .topbar-logout form {
    margin: 0;
  }

  .admin .topbar-logout button {
    background: none;
    border: 1px solid rgba(196, 181, 253, 0.2);
    color: #a78bca;
    padding: 0.3rem 0.8rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
  }

  .admin .topbar-logout button:hover {
    color: #e2d9f3;
    border-color: rgba(196, 181, 253, 0.4);
  }

  .admin .admin-main {
    padding: 2rem 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .admin .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .admin .page-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .admin h1 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
    line-height: 1.2;
  }

  .admin h2 {
    font-size: 0.8rem;
    font-weight: 700;
    color: #c4b5fd;
    margin: 0 0 1.25rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .admin .card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(196, 181, 253, 0.12);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .admin .card-note {
    font-size: 0.8rem;
    color: #a78bca;
    margin: -0.5rem 0 1.25rem;
    line-height: 1.5;
  }

  /* Table */
  .admin .table-wrap {
    overflow-x: auto;
    border-radius: 12px;
  }

  .admin .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .admin .data-table thead th {
    text-align: left;
    padding: 0.85rem 1rem;
    color: #a78bca;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(196, 181, 253, 0.15);
    background: rgba(255, 255, 255, 0.02);
    white-space: nowrap;
  }

  .admin .data-table tbody td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(196, 181, 253, 0.08);
    vertical-align: middle;
  }

  .admin .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .admin .data-table tbody tr:hover td {
    background: rgba(255, 255, 255, 0.03);
  }

  .admin .data-table .col-num {
    color: #6b5b8a;
    font-size: 0.8rem;
    width: 3rem;
  }

  .admin .data-table .col-product {
    min-width: 200px;
  }

  .admin .product-cell {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .admin .product-thumb {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(196, 181, 253, 0.15);
    flex-shrink: 0;
  }

  .admin .product-thumb-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    color: #6b5b8a;
  }

  .admin .product-name {
    font-weight: 600;
    color: #fff;
    display: block;
  }

  .admin .product-desc {
    font-size: 0.75rem;
    color: #6b5b8a;
    margin-top: 0.15rem;
    display: block;
    max-width: 280px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .admin .price {
    font-weight: 600;
    color: #e2d9f3;
    font-variant-numeric: tabular-nums;
  }

  .admin .price-sale {
    color: #6ee7b7;
    font-weight: 700;
  }

  .admin .price-muted {
    color: #4a3a6a;
  }

  .admin .scents-list {
    color: #a78bca;
    font-size: 0.8rem;
    max-width: 160px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .admin .table-empty {
    text-align: center;
    color: #6b5b8a;
    padding: 3rem 1rem !important;
  }

  /* Buttons */
  .admin .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.45rem 0.95rem;
    border-radius: 7px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
    font-family: 'Inter', sans-serif;
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .admin .btn-primary {
    background: #7c3aed;
    color: #fff;
  }

  .admin .btn-primary:hover {
    background: #6d28d9;
    color: #fff;
  }

  .admin .btn-secondary {
    background: rgba(196, 181, 253, 0.1);
    color: #c4b5fd;
    border: 1px solid rgba(196, 181, 253, 0.2);
  }

  .admin .btn-secondary:hover {
    background: rgba(196, 181, 253, 0.18);
    color: #e2d9f3;
  }

  .admin .btn-danger {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  .admin .btn-danger:hover {
    background: rgba(239, 68, 68, 0.25);
    color: #fca5a5;
  }

  .admin .btn-sm {
    padding: 0.3rem 0.65rem;
    font-size: 0.75rem;
  }

  /* Badges */
  .admin .badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .admin .badge-green {
    background: rgba(52, 211, 153, 0.15);
    color: #6ee7b7;
  }

  .admin .badge-red {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
  }

  .admin .badge-purple {
    background: rgba(196, 181, 253, 0.15);
    color: #c4b5fd;
  }

  /* Forms */
  .admin label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #a78bca;
    margin-bottom: 0.45rem;
    text-transform: uppercase;
  }

  .admin label.checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.875rem;
    color: #e2d9f3;
    margin-bottom: 0;
    cursor: pointer;
  }

  .admin input[type='text'],
  .admin input[type='number'],
  .admin input[type='email'],
  .admin input[type='password'],
  .admin input[type='url'],
  .admin textarea,
  .admin select {
    display: block;
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(196, 181, 253, 0.2);
    border-radius: 8px;
    color: #e2d9f3;
    padding: 0.6rem 0.8rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    -webkit-appearance: none;
    appearance: none;
  }

  .admin input::placeholder,
  .admin textarea::placeholder {
    color: rgba(167, 139, 202, 0.55);
  }

  .admin input:focus,
  .admin textarea:focus,
  .admin select:focus {
    border-color: rgba(196, 181, 253, 0.5);
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
  }

  .admin textarea {
    resize: vertical;
    min-height: 96px;
    line-height: 1.5;
  }

  .admin input[type='checkbox'] {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: #7c3aed;
    cursor: pointer;
    flex-shrink: 0;
  }

  .admin .form-field {
    margin-bottom: 1rem;
  }

  .admin .form-field:last-child {
    margin-bottom: 0;
  }

  .admin .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .admin .form-grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1rem;
    align-items: end;
  }

  .admin .form-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    padding-top: 0.25rem;
  }

  .admin .form-actions-spacer {
    flex: 1;
  }

  .admin .image-preview {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .admin .image-preview img {
    width: 80px;
    height: 80px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid rgba(196, 181, 253, 0.2);
    background: rgba(255, 255, 255, 0.04);
  }

  .admin .image-preview span {
    font-size: 0.8rem;
    color: #6b5b8a;
  }

  /* Alerts */
  .admin .alert {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .admin .alert-error {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  .admin .alert-success {
    background: rgba(52, 211, 153, 0.12);
    color: #6ee7b7;
    border: 1px solid rgba(52, 211, 153, 0.2);
  }

  .admin .unread-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #e879f9;
    border-radius: 50%;
    margin-right: 6px;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .admin .form-grid,
    .admin .form-grid-3 {
      grid-template-columns: 1fr;
    }

    .admin .form-grid-3 .checkbox-label {
      padding-bottom: 0.25rem;
    }

    .admin .data-table .col-scents,
    .admin .data-table .col-sale {
      display: none;
    }
  }
</style>
